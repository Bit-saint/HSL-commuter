          }
        }
      }
    },
    "The demo replays a recorded commute, live vehicles and GPS included, faster than real time. Turn on recording to replay your own trips later.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esittely toistaa tallennetun työmatkan ajoneuvoineen ja GPS-sijainteineen todellista nopeammin. Ota tallennus käyttöön, niin voit toistaa omia matkojasi myöhemmin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Demon spelar upp en inspelad pendling, med fordon och GPS, snabbare än i verkligheten. Slå på inspelning för att spela upp dina egna resor senare."
          }
        }
      }
    },
    "Then %@ at %@ · %@": {
      "localizations": {
